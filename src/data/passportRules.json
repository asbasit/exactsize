      "specified",
      "notSpecified",
      "notApplicable",
      "pathwayDependent"
    ],
    "measurementConventions": {
      "aspectRatio": "width:height",
      "pixelDimensions": "widthPx and heightPx",
      "fileSize": "Keep the source unit (KB or MB); do not silently convert until the authority's byte interpretation is confirmed.",
      "faceHeightPercent": "Percentage of total image height, unless a rule says otherwise."
    }
  },
