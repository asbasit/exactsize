---
import '../styles/global.css';
import sizes from '../data/sizes.json';
import forms from '../data/formPresets.json';
interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
const site = 'ExactSize';
const sizePaths = sizes.sizes.map((s) => `/${s.slug}/`);
const formPaths = forms.pages.map((p) => `/${p.slug}/`);
const nav = [
  { href: '/', label: 'Compress', match: (p: string) => p === '/' || sizePaths.includes(p) },
  { href: '/resize-image/', label: 'Resize', match: (p: string) => p === '/resize-image/' },
  { href: '/#forms', label: 'Exam forms', match: (p: string) => formPaths.includes(p) },
  { href: '/passport-photos/', label: 'Passport photos', match: (p: string) => p === '/passport-photos/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f6f4ef" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12h18"/><path d="M7 8v8M12 5v14M17 8v8"/></svg>
          {site}
        </a>
        <nav class="site-nav" aria-label="Tools">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <span>{site}. Your images are processed on your device and never uploaded.</span>
        <span>Last checked {sizes.lastVerified}</span>
      </div>
    </footer>
  </body>
</html>
