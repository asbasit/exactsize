---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — ExactSize" description="This page doesn't exist. Try one of the image tools instead." path="/404/" noindex>
  <div class="hero">
    <h1>That page isn't here</h1>
    <p class="lede">The link may be old or mistyped. These are the tools the site has:</p>
  </div>
  <div class="content">
    <nav class="size-links" aria-label="Tools">
      <a href="/">Compress to a KB size</a>
      <a href="/resize-image/">Resize to exact pixels</a>
      <a href="/#forms">Exam and visa forms</a>
      <a href="/passport-photos/">Passport photos</a>
    </nav>
  </div>
</Base>
